{
  "manifest_version": 3,
  "name": "Dopablock",
  "version": "1.1.0",
  "description": "Screen-time control for your browser: track, limit or block feeds like the TikTok FYP, Instagram Reels and YouTube Shorts.",
  "minimum_chrome_version": "110",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Dopablock",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": ["storage", "alarms", "favicon"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/lib/presets.js", "src/lib/i18n.js", "src/lib/engine.js", "src/content/overlay.js", "src/content/content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
